#!/bin/sh
# POSIX launcher: runs under any shell (sh / bash / zsh) via this shebang,
# with no dependency on bash being installed.
SCRIPT="$(readlink -f "$0" 2>/dev/null || echo "$0")"
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"

cmd=""
for py in python3 python3.14 python; do
    cmd=$(command -v "$py" 2>/dev/null) && break
done
if [ -z "$cmd" ]; then
    echo "Error: Python not found. Install Python 3.14+." >&2
    exit 1
fi
exec "$cmd" "$DIR/src/main.py" "$@"
